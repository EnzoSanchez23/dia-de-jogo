# =========================
# API CONFIG
# =========================
# API key do TheSportsDB
API_SPORTSDB=your_api_key_here

# ID do time (ex: Corinthians = 134284)
TEAM_ID=your_team_id_here

# Nome do time (ex: Corinthians)
TEAM_NAME=your_team_name_here


# =========================
# PUSH NOTIFICATIONS (Pushover)
# =========================
# Token da aplicação no Pushover
PUSHOVER_TOKEN=your_pushover_token_here

# User key do Pushover (seu dispositivo)
PUSHOVER_USER=your_pushover_user_here